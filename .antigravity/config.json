{
  "mcpServers": {
    "rea": {
      "command": "rea",
      "args": ["server"],
      "autoApprove": [
        "read_bytes",
        "read_function_instructions",
        "procedure_pseudo_code",
        "list_procedures",
        "search_procedures",
        "inspect_binary_layout"
      ]
    }
  },
  "permissions": {
    "defaultPolicy": "allow",
    "allowWorkspaceWrite": true,
    "allowProcessExecution": true
  }
}
